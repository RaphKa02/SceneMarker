{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SceneMarker",
  "version": "../package.json",
  "identifier": "de.karl-raphael.scene-marker",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../build"
  },
  "app": {
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "tooltip": "SceneMarker"
    },
    "windows": [
      {
        "title": "SceneMarker",
        "x": 0,
        "y": 0,
        "width": 1900,
        "height": 1000,
        "maximized": true,
        "theme": "Dark",
        "decorations": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "media-src": "'self' asset: http://asset.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "createUpdaterArtifacts": true,
    "publisher": "Raphael Karl",
    "shortDescription": "Video Scene Marker",
    "longDescription": "Simple cross-platform Video Scene Marker App für den Desktop.",
    "copyright": "GPL-3.0",
    "windows": {
      "wix": {
        "language": ["de-DE", "en-US"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["smp"],
        "name": "SceneMarker Projekt",
        "description": "SceneMarker Projekt Datei",
        "role": "Editor",
        "mimeType": "application/json"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwODI5QUJFRUY1MzI4OTkKUldTWktGUHZ2cHFDY0huU0VhK1EydVZSK01TYVU3N0RJMEM4QlBFQW45RVdOem9ESGlRUEpJWXkK",
      "endpoints": [
        "https://gitlab.karl-raphael.de/raphael/scene-marker/-/snippets/1/raw/main/updates.json"
      ]
    }
  }
}
