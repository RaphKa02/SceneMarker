{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SceneMarker",
  "version": "0.1.0",
  "identifier": "de.karl-raphael.scene-marker",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../build"
  },
  "app": {
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "tooltip": "SceneMarker"
    },
    "windows": [
      {
        "title": "SceneMarker",
        "x": 0,
        "y": 0,
        "width": 1900,
        "height": 1000,
        "maximized": true,
        "theme": "Dark",
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "media-src": "'self' asset: http://asset.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
