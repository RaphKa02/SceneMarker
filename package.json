{
  "name": "scene-marker",
  "version": "1.2.0",
  "description": "Video Scene Marker",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/buildNumber.cjs alpha true && vite dev",
    "build": "node scripts/buildNumber.cjs release false && vite build",
    "build:alpha": "node scripts/buildNumber.cjs alpha false && vite build",
    "rename": "node scripts/rename.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint:format": "prettier --check .",
    "tauri": "tauri"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "~2.7.1",
    "@tauri-apps/plugin-fs": "~2.4.5",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-store": "~2.4.3",
    "@tauri-apps/plugin-updater": "~2.9.0",
    "svelte-dnd-action": "^0.9.69"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^0.561.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.61.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "eslint-config-prettier": "^10.1.8",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^4.0.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "^5.56.0",
    "svelte-check": "^4.4.8",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.6.3",
    "vite": "^6.4.2"
  }
}
