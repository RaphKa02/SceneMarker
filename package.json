{
  "name": "scene-marker",
  "version": "1.2.1",
  "description": "Video Scene Marker",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/buildNumber.cjs alpha true && vite dev",
    "build": "node scripts/buildNumber.cjs release false && vite build",
    "build:alpha": "node scripts/buildNumber.cjs alpha false && vite build",
    "rename": "node scripts/rename.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint:format": "prettier --check .",
    "tauri": "tauri"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "konva": "^10.5.0",
    "svelte-dnd-action": "^0.9.79",
    "svelte-konva": "^1.0.1"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.46.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "eslint-config-prettier": "^10.1.8",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
