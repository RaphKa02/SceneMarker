{
  "name": "scene-marker",
  "version": "1.0.0",
  "description": "Video Scene Marker",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/buildNumber.cjs alpha true && vite dev",
    "build": "node scripts/buildNumber.cjs release false && vite build",
    "build:alpha": "node scripts/buildNumber.cjs alpha false && vite build",
    "rename": "node scripts/rename.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint:format": "prettier --check .",
    "tauri": "tauri"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-fs": "~2.4.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "~2.3.1",
    "@tauri-apps/plugin-process": "~2.3.0",
    "@tauri-apps/plugin-store": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.9.0",
    "svelte-dnd-action": "^0.9.65"
  },
  "devDependencies": {
    "@internationalized/date": "^3.9.0",
    "@lucide/svelte": "^0.544.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2",
    "bits-ui": "^2.11.4",
    "clsx": "^2.1.1",
    "eslint-config-prettier": "^10.1.8",
    "mode-watcher": "^1.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-sonner": "^1.0.5",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.1.1",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
